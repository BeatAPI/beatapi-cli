{
  "name": "beatapi",
  "version": "0.3.0",
  "description": "Command-line interface for BeatAPI models, Social Data, and workflows.",
  "type": "module",
  "bin": {
    "beatapi": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "beatapi-client": "0.3.0",
    "cross-keychain": "1.1.0"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeatAPI/beatapi-cli.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/BeatAPI/beatapi-cli/issues"
  },
  "homepage": "https://docs.beatapi.io/",
  "keywords": [
    "beatapi",
    "cli",
    "agent-toolkit",
    "social-data",
    "ai-video",
    "music-video",
    "ecommerce-video",
    "realtime-video",
    "automation"
  ],
  "license": "MIT"
}
