{
  "name": "beatapi-client",
  "version": "0.3.0",
  "description": "Type-safe JavaScript and TypeScript SDK for BeatAPI capability routing.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeatAPI/beatapi-cli.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/BeatAPI/beatapi-cli/issues"
  },
  "homepage": "https://docs.beatapi.io/",
  "keywords": [
    "beatapi",
    "agent-toolkit",
    "social-data",
    "ai-video",
    "music-video",
    "ecommerce-video",
    "realtime-video",
    "typescript",
    "sdk"
  ],
  "license": "MIT"
}
