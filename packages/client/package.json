{
  "name": "beatapi-client",
  "version": "0.4.0",
  "description": "Official JavaScript and TypeScript SDK for BeatAPI model, data, and workflow APIs, with capability discovery and task polling.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeatAPI/beatapi-cli.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/BeatAPI/beatapi-cli/issues"
  },
  "homepage": "https://docs.beatapi.io/",
  "keywords": [
    "beatapi",
    "sdk",
    "typescript",
    "javascript",
    "api-client",
    "ai-agents",
    "ai-models",
    "data-api",
    "social-data",
    "workflow",
    "image-generation",
    "video-generation"
  ],
  "license": "MIT"
}
